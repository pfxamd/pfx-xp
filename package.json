{
  "name": "pfx-xp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:xp": "node tools/prepare.mjs",
    "dev": "npm run prepare:xp && vite .pfx-workspace --config .pfx-workspace/vite.config.mjs",
    "build:local": "npm run prepare:xp && vite build .pfx-workspace --config .pfx-workspace/vite.config.mjs",
    "preview": "vite preview .pfx-workspace --config .pfx-workspace/vite.config.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.0",
    "styled-components": "^5.3.11",
    "webamp": "^2.3.1",
    "lodash.samplesize": "^4.2.0"
  },
  "devDependencies": {
    "vite": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
