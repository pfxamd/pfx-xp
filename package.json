{
  "name": "pfx-xp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:xp": "node scripts/prepare.mjs",
    "setup": "node scripts/prepare.mjs && npm install --prefix .pfx-runtime",
    "dev": "node scripts/prepare.mjs && npm run dev --prefix .pfx-runtime",
    "build:local": "node scripts/prepare.mjs && npm run build --prefix .pfx-runtime",
    "preview": "node scripts/prepare.mjs && npm run preview --prefix .pfx-runtime",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "check:source": "node scripts/check-source.mjs",
    "test:browser": "node scripts/prepare.mjs && npm run test:browser --prefix .pfx-runtime",
    "check:integration": "node scripts/check-integration.mjs",
    "verify:local": "npm run test:unit && npm run check:integration && npm run setup && npm run build:local && npx --prefix .pfx-runtime playwright install chromium firefox && npm run test:browser"
  }
}
