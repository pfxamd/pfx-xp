{
  "name": "pfx-xp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "npm ci --prefix upstream/web-xp",
    "prepare:xp": "node tools/prepare.mjs",
    "dev": "node tools/prepare.mjs && npm run start --prefix .pfx-workspace",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:xp": "node tools/prepare.mjs && npm run test --prefix .pfx-workspace",
    "test:smoke": "node tools/prepare.mjs && npm run test:smoke --prefix .pfx-workspace",
    "build:local": "node tools/prepare.mjs && npm run build --prefix .pfx-workspace"
  }
}
